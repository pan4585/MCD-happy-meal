# ============================================
# 麦麦儿童营养管家 — 环境变量模板
# 复制本文件为 .env 并填入你自己的真实值
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交到仓库
# ============================================

# 麦当劳 MCP Token（在 https://open.mcd.cn/mcp 控制台申请）
# 严禁把真实 Token 提交到任何公开仓库！
MCD_MCP_TOKEN=YOUR_MCP_TOKEN

# 麦当劳 MCP Server 接入地址（一般无需修改）
MCD_MCP_URL=https://mcp.mcd.cn
